# Supabase configuration for One Village
# Project: meqegazofwxrzvviixhl
VITE_SUPABASE_URL=https://meqegazofwxrzvviixhl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XSBsyqdON0_PTjn1BhfP5w_eX79Sbf-

# Server-side only — never commit the service role key to the client bundle.
# SUPABASE_SERVICE_ROLE_KEY=...

# Gemini AI (server-side only — used by /api/ai-search, /api/ai-guide and /api/chat)
GEMINI_API_KEY=

# Coarena AI (server-side only — OpenAI-compatible fallback reasoner for /api/chat)
COARENA_API_KEY=
COARENA_URL=https://coarena.ai/api/v1
# Optional: override the Coarena model (default gpt-6-luna)
# COARENA_MODEL=gpt-6-luna

# Push notifications (server-side only — used by /api/admin/push/send)
# ONESIGNAL_APP_ID=...
# ONESIGNAL_REST_API_KEY=...

# Render assigns PORT dynamically at deploy time.
# PORT=3000